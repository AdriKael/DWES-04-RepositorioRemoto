<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de cobertura: excluye Program.cs (punto de entrada
     consola / top-level statements, sin lógica testeable). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Program.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
